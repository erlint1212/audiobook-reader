package views

import (
	"audiobook-reader/internal/bundle"
	"audiobook-reader/internal/progress"
)

templ LibraryPage(books []bundle.Book) {
	@Layout("Library") {
		<div class="mb-6 flex items-center justify-between">
			<h1 class="text-2xl font-bold">Library</h1>
			@refreshButton("/refresh")
		</div>
		if len(books) == 0 {
			<p class="text-stone-500">No books found. Point <code>-library</code> at a folder of forge bundles.</p>
		}
		<ul class="grid gap-4 sm:grid-cols-2">
			for _, b := range books {
				<li>
					<a href={ bookURL(b.Manifest.ID) } class="block rounded-lg border border-stone-200 p-4 hover:bg-stone-100 dark:border-stone-700 dark:hover:bg-stone-800">
						if b.Manifest.Cover != "" {
							<img src={ coverURL(b.Manifest.ID) } alt="" class="mb-3 aspect-[2/3] w-full rounded object-cover"/>
						}
						<div class="font-semibold">{ b.Manifest.Title }</div>
						<div class="text-sm text-stone-500">{ b.Manifest.Author }</div>
					</a>
				</li>
			}
		</ul>
	}
}

templ BookPage(b bundle.Book, pos progress.Position, hasPos bool) {
	@Layout(b.Manifest.Title) {
		<div class="flex items-center justify-between gap-4">
			<h1 class="text-2xl font-bold">{ b.Manifest.Title }</h1>
			@refreshButton(refreshURL(b.Manifest.ID))
		</div>
		<p class="mb-6 text-stone-500">{ b.Manifest.Author }</p>
		if hasPos {
			<a href={ resumeURL(b.Manifest.ID, pos) } class="mb-6 inline-block rounded bg-amber-500 px-4 py-2 font-semibold text-stone-900 hover:bg-amber-400">
				Resume chapter { itoa(pos.Chapter) } at { clock(pos.Time) }
			</a>
		}
		<ol class="divide-y divide-stone-200 dark:divide-stone-700">
			for _, ch := range b.Manifest.Chapters {
				<li>
					<a href={ chapterURL(b.Manifest.ID, ch.Index) } class="flex justify-between py-2 hover:underline">
						<span class="flex gap-3">
							@chapterNum(ch.Index)
							<span>{ ch.Title }</span>
						</span>
						<span class="text-sm text-stone-500 tabular-nums">{ clock(ch.DurationS) }</span>
					</a>
				</li>
			}
		</ol>
	}
}

templ ReaderPage(b bundle.Book, ch bundle.Chapter, a bundle.Alignment, start float64) {
	@Layout(ch.Title + " · " + b.Manifest.Title) {
		@Reader(b, ch, a, start)
	}
}

// Reader is also returned alone as an htmx fragment when switching chapters.
// All per-word styling lives here; sync.js only toggles data-active.
templ Reader(b bundle.Book, ch bundle.Chapter, a bundle.Alignment, start float64) {
	<section
		id="reader"
		x-data="reader"
		data-start={ secs(start) }
		data-chapter={ itoa(ch.Index) }
		x-on:keydown.window="key($event)"
		x-on:keydown.escape.window="chapters = false"
		x-on:wheel.window="unfollow($event)"
		x-on:touchmove.window="unfollow($event)"
	>
		<div x-ref="top" class="sticky top-0 z-10 -mx-4 bg-stone-50/95 px-4 py-3 backdrop-blur dark:bg-stone-900/95">
			<div class="flex items-center justify-between gap-2 text-sm">
				<div class="flex items-center gap-1">
					<button
						type="button"
						aria-label="Chapters"
						x-on:click="openChapters()"
						x-bind:aria-expanded="chapters"
						class="rounded px-2 py-1 hover:bg-stone-200 dark:hover:bg-stone-700"
					>☰</button>
					@chapterLink(b, ch.Index-1, "← Prev", "prev")
				</div>
				<a href={ bookURL(b.Manifest.ID) } class="truncate font-semibold hover:underline">{ ch.Title }</a>
				@NextLink(b, ch.Index)
			</div>
		</div>
		// Sibling of the top bar, not inside it: its backdrop-blur would make
		// these fixed elements position relative to the bar.
		@chapterDrawer(b, ch.Index)
		// pb-[40vh] lets the last lines scroll up past the fixed player bar.
		<article
			x-ref="text"
			x-on:click="seek($event)"
			class="mt-4 pb-[40vh] text-lg space-y-4 leading-relaxed [&_span]:cursor-pointer [&_span]:rounded [&_span]:px-0.5 [&_span:hover]:bg-stone-200 dark:[&_span:hover]:bg-stone-700 [&_span[data-active]]:bg-amber-300 dark:[&_span[data-active]]:bg-amber-600"
		>
			for bi, blk := range a.Blocks {
				switch blk.Kind {
					case bundle.KindHeading:
						<h2 class="text-xl font-bold">
							@words(blk.Words)
						</h2>
					case bundle.KindFigure:
						// The ring shows while any caption word is active: pure CSS :has().
						<figure class="rounded-lg p-2 transition-shadow has-[span[data-active]]:ring-4 has-[span[data-active]]:ring-amber-300 dark:has-[span[data-active]]:ring-amber-600">
							<img src={ imageURL(b.Manifest.ID, ch.Index, bi) } alt="" loading="lazy" class="mx-auto max-h-[70vh] rounded"/>
							if len(blk.Words) > 0 {
								<figcaption class="mt-2 text-center text-base italic text-stone-600 dark:text-stone-400">
									@words(blk.Words)
								</figcaption>
							}
						</figure>
					default:
						<p>
							@words(blk.Words)
						</p>
				}
			}
		</article>
		<button
			type="button"
			x-show="!follow"
			x-on:click="resumeFollow()"
			class="fixed bottom-32 left-1/2 z-20 -translate-x-1/2 rounded-full bg-amber-500 px-4 py-2 font-semibold text-stone-900 shadow-lg hover:bg-amber-400"
		>
			Back to reading position
		</button>
		// Player bar, fixed to the bottom. Native controls are hidden; these
		// buttons drive the <audio> through sync.js.
		<div x-ref="bar" class="fixed inset-x-0 bottom-0 z-10 border-t border-stone-200 bg-stone-50/95 backdrop-blur dark:border-stone-700 dark:bg-stone-900/95">
			<audio x-ref="audio" src={ audioURL(b.Manifest.ID, ch.Index) } preload="metadata" class="hidden"></audio>
			<div class="mx-auto max-w-3xl px-4 py-3">
				<div class="flex items-center gap-3 text-sm tabular-nums text-stone-500">
					<span x-text="clock(time)" class="w-12 text-right">0:00</span>
					<input
						type="range"
						min="0"
						step="0.1"
						aria-label="Position"
						x-bind:max="duration"
						x-bind:value="time"
						x-on:input="scrub($event)"
						class="h-1 flex-1 cursor-pointer accent-amber-500"
					/>
					<span x-text="clock(duration)" class="w-12">0:00</span>
				</div>
				// Three columns keep play/pause centred, speed control on the right.
				<div class="mt-2 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
					<div></div>
					<div class="flex items-center gap-6">
						@skipButton(-10, "Back 10 seconds", "−10s")
						<button
							type="button"
							aria-label="Play or pause"
							x-on:click="toggle()"
							x-bind:aria-pressed="playing"
							class="flex size-14 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-stone-900 shadow hover:bg-amber-400 active:scale-95"
						>
							<span x-text="playing ? '❚❚' : '▶'">▶</span>
						</button>
						@skipButton(10, "Forward 10 seconds", "+10s")
					</div>
					@speedControl()
				</div>
			</div>
		</div>
		<form x-ref="pos" hx-post={ progressURL(b.Manifest.ID) } hx-trigger="savepos" hx-swap="none" class="hidden">
			<input type="hidden" name="chapter" value={ itoa(ch.Index) }/>
			<input type="hidden" name="time" x-bind:value="time.toFixed(3)"/>
		</form>
	</section>
}

// words renders one clickable span per word; sync.js highlights them.
templ words(ws []bundle.Word) {
	for _, w := range ws {
		<span data-s={ secs(w.S) }>{ w.T }</span>{ " " }
	}
}

// skipButton jumps the audio by secs (negative = back).
templ skipButton(secs int, aria string, label string) {
	<button
		type="button"
		aria-label={ aria }
		x-on:click={ "skip(" + itoa(secs) + ")" }
		class="flex size-11 items-center justify-center rounded-full text-sm font-semibold hover:bg-stone-200 active:scale-95 dark:hover:bg-stone-700"
	>{ label }</button>
}

// speedControl sets audio.playbackRate, 0.5x to 3x. The label shows the
// rate; clicking it resets to 1x.
templ speedControl() {
	<div class="flex items-center justify-end gap-2 text-sm tabular-nums text-stone-500">
		<input
			type="range"
			min="0.5"
			max="3"
			step="0.1"
			aria-label="Playback speed"
			x-bind:value="speed"
			x-on:input="setSpeed($event.target.value)"
			class="h-1 w-20 cursor-pointer accent-amber-500 sm:w-28"
		/>
		<button
			type="button"
			aria-label="Reset speed to 1x"
			x-on:click="setSpeed(1)"
			x-text="speed.toFixed(1) + '×'"
			class="w-12 rounded px-1 text-left hover:bg-stone-200 dark:hover:bg-stone-700"
		>1.0×</button>
	</div>
}

// refreshButton rescans the library on the server, which redirects back.
templ refreshButton(action string) {
	<form method="post" action={ templ.SafeURL(action) }>
		<button type="submit" class="rounded border border-stone-300 px-3 py-1 text-sm hover:bg-stone-200 dark:border-stone-600 dark:hover:bg-stone-700">
			Refresh
		</button>
	</form>
}

// NextLink is the reader's "Next →". On the last known chapter it is a
// placeholder that polls the server, which rescans; once forge has written
// the next chapter the live link swaps in. Its x-init tells the reader, so a
// listener who already reached the end keeps going. Also an htmx fragment.
templ NextLink(b bundle.Book, cur int) {
	if cur < len(b.Manifest.Chapters) {
		<span class="contents" x-init="nextReady()">
			@chapterLink(b, cur+1, "Next →", "next")
		</span>
	} else {
		<span
			hx-get={ nextURL(b.Manifest.ID, cur) }
			hx-trigger="every 30s"
			hx-swap="outerHTML"
			title="Last chapter so far; checking for more"
			class="px-2 py-1 text-stone-400"
		>Next →</span>
	}
}

// rel ("prev"/"next") also lets sync.js find the next link to auto-advance.
templ chapterLink(b bundle.Book, index int, label string, rel string) {
	if index >= 1 && index <= len(b.Manifest.Chapters) {
		<a
			href={ chapterURL(b.Manifest.ID, index) }
			rel={ rel }
			hx-get={ string(chapterURL(b.Manifest.ID, index)) }
			hx-target="#reader"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="rounded px-2 py-1 hover:bg-stone-200 dark:hover:bg-stone-700"
		>{ label }</a>
	} else {
		<span class="px-2 py-1 text-stone-400">{ label }</span>
	}
}

// chapterNum is the "1." in front of a chapter title.
templ chapterNum(i int) {
	<span class="w-8 shrink-0 text-right tabular-nums text-stone-500">{ itoa(i) }.</span>
}

// chapterDrawer is the reader's chapter list: an overlay on the left, above
// the page, so opening it moves no text and leaves the audio alone. It lives
// inside #reader, so picking a chapter swaps it out (closed) with the rest.
// Links carry no rel, so sync.js's a[rel=next] still finds only "Next →".
// x-cloak hides both parts until Alpine starts; Alpine then drops the attribute.
templ chapterDrawer(b bundle.Book, cur int) {
	<div
		x-cloak
		x-show="chapters"
		x-on:click="chapters = false"
		x-transition.opacity
		class="fixed inset-0 z-30 bg-stone-900/30 [&[x-cloak]]:hidden"
	></div>
	<nav
		x-cloak
		x-ref="drawer"
		x-show="chapters"
		x-transition:enter="transition duration-200"
		x-transition:enter-start="-translate-x-full"
		x-transition:enter-end="translate-x-0"
		x-transition:leave="transition duration-150"
		x-transition:leave-start="translate-x-0"
		x-transition:leave-end="-translate-x-full"
		aria-label="Chapters"
		class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] overflow-y-auto overscroll-contain bg-stone-50 shadow-xl dark:bg-stone-900 [&[x-cloak]]:hidden"
	>
		<div class="sticky top-0 flex items-center justify-between border-b border-stone-200 bg-stone-50 px-4 py-3 dark:border-stone-700 dark:bg-stone-900">
			<span class="font-semibold">Chapters</span>
			<button
				type="button"
				aria-label="Close chapters"
				x-on:click="chapters = false"
				class="rounded px-2 py-1 hover:bg-stone-200 dark:hover:bg-stone-700"
			>✕</button>
		</div>
		<ol class="py-2">
			for _, c := range b.Manifest.Chapters {
				<li>
					<a
						href={ chapterURL(b.Manifest.ID, c.Index) }
						hx-get={ string(chapterURL(b.Manifest.ID, c.Index)) }
						hx-target="#reader"
						hx-swap="outerHTML"
						hx-push-url="true"
						x-on:click="pick()"
						if c.Index == cur {
							aria-current="page"
						}
						class="flex gap-3 px-4 py-2 text-sm hover:bg-stone-200 dark:hover:bg-stone-700 aria-[current=page]:bg-amber-200 aria-[current=page]:font-semibold dark:aria-[current=page]:bg-amber-700"
					>
						@chapterNum(c.Index)
						<span class="flex-1">{ c.Title }</span>
						<span class="tabular-nums text-stone-500">{ clock(c.DurationS) }</span>
					</a>
				</li>
			}
		</ol>
	</nav>
}
