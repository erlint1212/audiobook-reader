{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiobook.local/schema/bundle.v3.schema.json",
  "title": "Audiobook bundle v3",
  "description": "Contract between audiobook-forge (writer) and audiobook-reader (reader). Keep byte-identical in both repos. v3 adds the glossary (hover entries from the book's index, glossary.json) and per-chapter marks (where its terms occur, NNN.marks.json); readers still load v1 and v2.",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "title", "author", "language", "voice", "created", "chapters"],
      "properties": {
        "schema_version": { "const": 3 },
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "voice": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "cover": { "type": "string" },
        "glossary": { "type": "string", "minLength": 1 },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "title", "audio", "alignment", "duration_s"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "audio": { "type": "string", "minLength": 1 },
        "alignment": { "type": "string", "minLength": 1 },
        "duration_s": { "type": "number", "minimum": 0 },
        "marks": { "type": "string", "minLength": 1 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chapter_index", "blocks"],
      "properties": {
        "schema_version": { "const": 3 },
        "chapter_index": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "description": "A \"fig\" block is a picture: image is a bundle path, words (caption, else alt text) may be empty. \"p\"/\"h\" blocks have words and no image.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "words"],
      "properties": {
        "kind": { "enum": ["p", "h", "fig"] },
        "image": { "type": "string", "minLength": 1 },
        "words": { "type": "array", "items": { "$ref": "#/$defs/word" } }
      },
      "if": { "properties": { "kind": { "const": "fig" } } },
      "then": { "required": ["image"] },
      "else": { "not": { "required": ["image"] }, "properties": { "words": { "minItems": 1 } } }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "s", "e"],
      "properties": {
        "t": { "type": "string", "minLength": 1 },
        "s": { "type": "number", "minimum": 0 },
        "e": { "type": "number", "minimum": 0 }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "const": 3 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "entry": {
      "description": "One hover box. id is its position in entries. text is a definition, or the sentence the index points at; source is that sentence's section; see lists sub-entries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "text"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "term": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "see": { "type": "array", "items": { "type": "string" } }
      }
    },
    "marks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chapter_index", "marks"],
      "properties": {
        "schema_version": { "const": 3 },
        "chapter_index": { "type": "integer", "minimum": 1 },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" } }
      }
    },
    "mark": {
      "description": "Words w .. w+n-1 of paragraph block b are an occurrence of glossary entry g. Sorted, never overlapping.",
      "type": "object",
      "additionalProperties": false,
      "required": ["b", "w", "n", "g"],
      "properties": {
        "b": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 0 },
        "n": { "type": "integer", "minimum": 1 },
        "g": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/alignment" },
    { "$ref": "#/$defs/glossary" },
    { "$ref": "#/$defs/marks" }
  ]
}
