{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiobook.local/schema/bundle.v1.schema.json",
  "title": "Audiobook bundle v1",
  "description": "Contract between audiobook-forge (writer) and audiobook-reader (reader). Keep byte-identical in both repos. Any breaking change needs schema_version 2.",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "title", "author", "language", "voice", "created", "chapters"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "voice": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "cover": { "type": "string" },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "title", "audio", "alignment", "duration_s"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "audio": { "type": "string", "minLength": 1 },
        "alignment": { "type": "string", "minLength": 1 },
        "duration_s": { "type": "number", "minimum": 0 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chapter_index", "blocks"],
      "properties": {
        "schema_version": { "const": 1 },
        "chapter_index": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "words"],
      "properties": {
        "kind": { "enum": ["p", "h"] },
        "words": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/word" } }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "s", "e"],
      "properties": {
        "t": { "type": "string", "minLength": 1 },
        "s": { "type": "number", "minimum": 0 },
        "e": { "type": "number", "minimum": 0 }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/manifest" }, { "$ref": "#/$defs/alignment" }]
}
